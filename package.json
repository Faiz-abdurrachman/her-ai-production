{
  "name": "her-ai",
  "version": "1.0.0",
  "description": "Control panel, participant portal, learning dashboard, assessment tools, messaging prototype, and meeting infrastructure for HerAI Fellowship.",
  "main": "append_css.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm run test:qa:mock",
    "test:qa:list": "playwright test --list",
    "test:qa:mock": "playwright test e2e/active-modules-ui.spec.js e2e/ui-ux-contract.spec.js e2e/p5-ux-polish.spec.js --workers=1",
    "test:qa:live:read": "playwright test e2e/participant-backend.spec.js e2e/fellow-dashboard.spec.js --workers=1",
    "test:qa:live:write": "playwright test e2e/participant-backend.spec.js e2e/participant-workflow.spec.js --workers=1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faiz-abdurrachman/her-ai-production.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Faiz-abdurrachman/her-ai-production/issues"
  },
  "homepage": "https://github.com/Faiz-abdurrachman/her-ai-production#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
